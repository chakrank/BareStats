#include <windows.h>
#include "resource.h"

// Embedded Application Icon (first icon is automatically used by Windows Explorer)
IDI_APP_ICON ICON "bare_stats.ico"

// Version Information (Properties -> Details in Windows Explorer)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,9,0,0
PRODUCTVERSION  0,9,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "BareStats Project"
            VALUE "FileDescription",  "BareStats Lightweight Telemetry Overlay"
            VALUE "FileVersion",      "0.9.0.0"
            VALUE "InternalName",     "BareStats"
            VALUE "LegalCopyright",   "Copyright (C) 2026 BareStats Contributors"
            VALUE "OriginalFilename", "BareStats.exe"
            VALUE "ProductName",      "BareStats"
            VALUE "ProductVersion",   "0.9.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
